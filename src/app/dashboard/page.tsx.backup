"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import {
  ArrowRight,
  CalendarDays,
  CheckCircle2,
  Clock3,
  MapPin,
  Search,
  Settings,
  User,
  XCircle,
} from "lucide-react";

type UserData = {
  id: string;
  fullName: string;
  email: string;
  phone: string | null;
  role: string;
  createdAt: string;
};

type Booking = {
  id: string;
  bookingDate: string;
  status: "PENDING" | "CONFIRMED" | "CANCELLED" | "COMPLETED";
  notes: string | null;
  createdAt: string;
  service: {
    id: string;
    title: string;
    price: string;
    durationMinutes: number;
    vendor: string;
    city: string;
    category: string;
  };
};

type DashboardData = {
  stats: {
    totalBookings: number;
    pendingBookings: number;
    confirmedBookings: number;
    completedBookings: number;
    cancelledBookings: number;
  };
  recentBookings: Booking[];
};

export default function DashboardPage() {
  const [user, setUser] = useState<UserData | null>(null);
  const [dashboard, setDashboard] = useState<DashboardData | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    async function loadDashboard() {
      try {
        const [meResponse, dashboardResponse] = await Promise.all([
          fetch("/api/auth/me", {
            cache: "no-store",
          }),
          fetch("/api/dashboard", {
            cache: "no-store",
          }),
        ]);

        if (meResponse.status === 401 || dashboardResponse.status === 401) {
          window.location.href = "/login";
          return;
        }

        const meData = await meResponse.json();
        const dashboardData = await dashboardResponse.json();

        if (!meResponse.ok) {
          throw new Error(meData.message || "Unable to load account.");
        }

        if (!dashboardResponse.ok) {
          throw new Error(
            dashboardData.message || "Unable to load dashboard."
          );
        }

        setUser(meData.user);
        setDashboard(dashboardData);
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Unable to load dashboard."
        );
      } finally {
        setLoading(false);
      }
    }

    loadDashboard();
  }, []);

  if (loading) {
    return <DashboardSkeleton />;
  }

  if (error) {
    return (
      <main className="min-h-screen bg-slate-50 px-5 py-12">
        <div className="mx-auto max-w-3xl rounded-2xl border border-red-200 bg-red-50 p-6 text-red-700">
          {error}
        </div>
      </main>
    );
  }

  if (!user || !dashboard) {
    return null;
  }

  return (
    <main className="min-h-screen bg-slate-50">
      {/* Header */}
      <header className="border-b border-slate-200 bg-white">
        <div className="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8">
          <Link
            href="/"
            className="flex items-center gap-3 text-lg font-bold text-slate-950"
          >
            <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-950 text-white">
              B
            </span>
            Baaraath
          </Link>

          <nav className="flex items-center gap-2">
            <Link
              href="/services"
              className="hidden rounded-xl px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 sm:block"
            >
              Find Services
            </Link>

            <Link
              href="/dashboard/profile"
              className="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
            >
              <User className="h-4 w-4" />
              <span className="hidden sm:inline">Profile</span>
            </Link>
          </nav>
        </div>
      </header>

      <div className="mx-auto max-w-7xl px-5 py-8 sm:px-8">
        {/* Welcome */}
        <section className="mb-8">
          <div className="flex flex-col justify-between gap-5 md:flex-row md:items-end">
            <div>
              <p className="text-sm font-medium text-slate-500">
                Customer Dashboard
              </p>

              <h1 className="mt-1 text-3xl font-bold tracking-tight text-slate-950">
                Welcome back, {getFirstName(user.fullName)}
              </h1>

              <p className="mt-2 text-sm text-slate-500">
                Manage your bookings and discover services for your
                upcoming events.
              </p>
            </div>

            <Link
              href="/services"
              className="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-slate-950 px-5 text-sm font-semibold text-white hover:bg-slate-800"
            >
              <Search className="h-4 w-4" />
              Find a Service
            </Link>
          </div>
        </section>

        {/* Stats */}
        <section className="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          <StatCard
            icon={<CalendarDays className="h-5 w-5" />}
            label="Total bookings"
            value={dashboard.stats.totalBookings}
          />

          <StatCard
            icon={<Clock3 className="h-5 w-5" />}
            label="Pending"
            value={dashboard.stats.pendingBookings}
          />

          <StatCard
            icon={<CheckCircle2 className="h-5 w-5" />}
            label="Confirmed"
            value={dashboard.stats.confirmedBookings}
          />

          <StatCard
            icon={<CheckCircle2 className="h-5 w-5" />}
            label="Completed"
            value={dashboard.stats.completedBookings}
          />

          <StatCard
            icon={<XCircle className="h-5 w-5" />}
            label="Cancelled"
            value={dashboard.stats.cancelledBookings}
          />
        </section>

        <div className="mt-8 grid gap-6 lg:grid-cols-[1fr_320px]">
          {/* Recent bookings */}
          <section className="rounded-2xl border border-slate-200 bg-white">
            <div className="flex items-center justify-between border-b border-slate-100 px-5 py-4">
              <div>
                <h2 className="font-semibold text-slate-950">
                  Recent bookings
                </h2>

                <p className="mt-1 text-xs text-slate-500">
                  Your latest service bookings
                </p>
              </div>

              <Link
                href="/dashboard/bookings"
                className="inline-flex items-center gap-1 text-sm font-medium text-slate-700 hover:text-slate-950"
              >
                View all
                <ArrowRight className="h-4 w-4" />
              </Link>
            </div>

            {dashboard.recentBookings.length === 0 ? (
              <EmptyBookings />
            ) : (
              <div className="divide-y divide-slate-100">
                {dashboard.recentBookings.map((booking) => (
                  <BookingRow key={booking.id} booking={booking} />
                ))}
              </div>
            )}
          </section>

          {/* Sidebar */}
          <aside className="space-y-6">
            <section className="rounded-2xl border border-slate-200 bg-white p-5">
              <div className="flex items-center gap-3">
                <div className="flex h-11 w-11 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-700">
                  {getInitials(user.fullName)}
                </div>

                <div className="min-w-0">
                  <h2 className="truncate font-semibold text-slate-950">
                    {user.fullName}
                  </h2>

                  <p className="truncate text-xs text-slate-500">
                    {user.email}
                  </p>
                </div>
              </div>

              <div className="mt-5 space-y-3 border-t border-slate-100 pt-5">
                <Link
                  href="/dashboard/profile"
                  className="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100"
                >
                  <span className="flex items-center gap-3">
                    <User className="h-4 w-4" />
                    Edit profile
                  </span>

                  <ArrowRight className="h-4 w-4" />
                </Link>

                <Link
                  href="/dashboard/bookings"
                  className="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100"
                >
                  <span className="flex items-center gap-3">
                    <CalendarDays className="h-4 w-4" />
                    My bookings
                  </span>

                  <ArrowRight className="h-4 w-4" />
                </Link>

                <Link
                  href="/services"
                  className="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100"
                >
                  <span className="flex items-center gap-3">
                    <Search className="h-4 w-4" />
                    Browse services
                  </span>

                  <ArrowRight className="h-4 w-4" />
                </Link>
              </div>
            </section>

            <section className="rounded-2xl bg-slate-950 p-5 text-white">
              <p className="text-xs font-semibold uppercase tracking-wider text-white/50">
                Need help?
              </p>

              <h3 className="mt-2 text-lg font-semibold">
                Looking for a service?
              </h3>

              <p className="mt-2 text-sm leading-6 text-white/60">
                Browse available providers and services for your next
                event.
              </p>

              <Link
                href="/services"
                className="mt-5 inline-flex items-center gap-2 text-sm font-semibold"
              >
                Explore services
                <ArrowRight className="h-4 w-4" />
              </Link>
            </section>
          </aside>
        </div>
      </div>
    </main>
  );
}

function StatCard({
  icon,
  label,
  value,
}: {
  icon: React.ReactNode;
  label: string;
  value: number;
}) {
  return (
    <div className="rounded-2xl border border-slate-200 bg-white p-5">
      <div className="flex items-center justify-between">
        <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
          {icon}
        </div>
      </div>

      <p className="mt-4 text-2xl font-bold text-slate-950">{value}</p>

      <p className="mt-1 text-xs text-slate-500">{label}</p>
    </div>
  );
}

function BookingRow({ booking }: { booking: Booking }) {
  return (
    <Link
      href={`/dashboard/bookings?booking=${encodeURIComponent(booking.id)}`}
      className="block px-5 py-5 transition hover:bg-slate-50"
    >
      <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div className="flex min-w-0 gap-4">
          <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-100">
            <CalendarDays className="h-5 w-5 text-slate-600" />
          </div>

          <div className="min-w-0">
            <h3 className="truncate font-semibold text-slate-950">
              {booking.service.title}
            </h3>

            <p className="mt-1 text-sm text-slate-500">
              {booking.service.vendor}
            </p>

            <div className="mt-2 flex flex-wrap items-center gap-3 text-xs text-slate-400">
              <span className="flex items-center gap-1">
                <MapPin className="h-3.5 w-3.5" />
                {booking.service.city}
              </span>

              <span>
                {formatDate(booking.bookingDate)}
              </span>
            </div>
          </div>
        </div>

        <div className="flex shrink-0 items-center gap-3">
          <StatusBadge status={booking.status} />

          <ArrowRight className="hidden h-4 w-4 text-slate-400 sm:block" />
        </div>
      </div>
    </Link>
  );
}

function StatusBadge({
  status,
}: {
  status: Booking["status"];
}) {
  const styles = {
    PENDING: "bg-amber-50 text-amber-700 border-amber-200",
    CONFIRMED: "bg-emerald-50 text-emerald-700 border-emerald-200",
    COMPLETED: "bg-blue-50 text-blue-700 border-blue-200",
    CANCELLED: "bg-red-50 text-red-700 border-red-200",
  };

  return (
    <span
      className={`rounded-full border px-3 py-1 text-xs font-semibold ${styles[status]}`}
    >
      {status.charAt(0) + status.slice(1).toLowerCase()}
    </span>
  );
}

function EmptyBookings() {
  return (
    <div className="px-5 py-16 text-center">
      <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100">
        <CalendarDays className="h-6 w-6 text-slate-500" />
      </div>

      <h3 className="mt-4 font-semibold text-slate-950">
        No bookings yet
      </h3>

      <p className="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
        You haven&apos;t made any bookings yet. Explore available
        services and find something for your next event.
      </p>

      <Link
        href="/services"
        className="mt-5 inline-flex items-center gap-2 rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800"
      >
        Find services
        <ArrowRight className="h-4 w-4" />
      </Link>
    </div>
  );
}

function DashboardSkeleton() {
  return (
    <main className="min-h-screen bg-slate-50">
      <div className="mx-auto max-w-7xl px-5 py-10 sm:px-8">
        <div className="h-8 w-64 animate-pulse rounded-lg bg-slate-200" />

        <div className="mt-3 h-4 w-96 max-w-full animate-pulse rounded bg-slate-200" />

        <div className="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {Array.from({ length: 5 }).map((_, index) => (
            <div
              key={index}
              className="h-32 animate-pulse rounded-2xl bg-white"
            />
          ))}
        </div>

        <div className="mt-8 h-96 animate-pulse rounded-2xl bg-white" />
      </div>
    </main>
  );
}

function getFirstName(name: string) {
  return name.trim().split(/\s+/)[0] || "there";
}

function getInitials(name: string) {
  const parts = name.trim().split(/\s+/).filter(Boolean);

  return parts
    .slice(0, 2)
    .map((part) => part[0].toUpperCase())
    .join("");
}

function formatDate(value: string) {
  return new Intl.DateTimeFormat("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(new Date(value));
}